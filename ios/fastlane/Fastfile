default_platform(:ios)

APP_BUNDLE_ID = "com.okib.NamazVakti"
WIDGET_BUNDLE_ID = "com.okib.NamazVakti.NamazVaktiWidget"
DEFAULT_TEAM_ID = "3SN795A9D6"

platform :ios do
  private_lane :load_asc_api_key do
    key_id = ENV["APP_STORE_CONNECT_API_KEY_ID"] || ENV["ASC_KEY_ID"]
    issuer_id = ENV["APP_STORE_CONNECT_ISSUER_ID"] || ENV["ASC_ISSUER_ID"]
    key_base64 = ENV["APP_STORE_CONNECT_API_KEY_BASE64"]
    key_path = ENV["APP_STORE_CONNECT_API_KEY_PATH"] || ENV["ASC_KEY_PATH"]

    if key_id && issuer_id && key_base64 && !key_base64.empty?
      app_store_connect_api_key(
        key_id: key_id,
        issuer_id: issuer_id,
        key_content: key_base64,
        is_key_content_base64: true,
        in_house: false
      )
    elsif key_id && issuer_id && key_path && !key_path.empty?
      app_store_connect_api_key(
        key_id: key_id,
        issuer_id: issuer_id,
        key_filepath: File.expand_path(key_path),
        in_house: false
      )
    else
      nil
    end
  end

  desc "Regenerate Xcode project via XcodeGen and run unit tests on iPhone Simulator"
  lane :test do
    sh("cd .. && xcodegen generate")
    run_tests(
      project: "NamazVakti.xcodeproj",
      scheme: "NamazVakti",
      clean: false
    )
  end

  desc "Build signed .ipa archive for App Store Connect / TestFlight"
  lane :build do |options|
    sh("cd .. && xcodegen generate")

    if options[:version] && !options[:version].to_s.empty?
      increment_version_number(
        xcodeproj: "NamazVakti.xcodeproj",
        version_number: options[:version].to_s
      )
    end

    if options[:build_number] && !options[:build_number].to_s.empty?
      increment_build_number(
        xcodeproj: "NamazVakti.xcodeproj",
        build_number: options[:build_number].to_s
      )
    end

    team_id = ENV["APPLE_TEAM_ID"] || DEFAULT_TEAM_ID
    app_profile = ENV["IOS_APP_PROVISIONING_PROFILE_NAME"] || ENV["APP_PROVISIONING_PROFILE_SPECIFIER"]
    widget_profile = ENV["IOS_WIDGET_PROVISIONING_PROFILE_NAME"] || ENV["WIDGET_PROVISIONING_PROFILE_SPECIFIER"]

    key_id = ENV["APP_STORE_CONNECT_API_KEY_ID"] || ENV["ASC_KEY_ID"]
    issuer_id = ENV["APP_STORE_CONNECT_ISSUER_ID"] || ENV["ASC_ISSUER_ID"]
    key_path = ENV["APP_STORE_CONNECT_API_KEY_PATH"] || ENV["ASC_KEY_PATH"]

    export_options = {
      method: "app-store-connect",
      teamID: team_id,
      uploadSymbols: true,
      stripSwiftSymbols: true
    }

    xcargs_list = ["DEVELOPMENT_TEAM=#{team_id}"]
    export_xcargs_list = []

    if app_profile && !app_profile.empty? && widget_profile && !widget_profile.empty?
      export_options[:signingStyle] = "manual"
      export_options[:provisioningProfiles] = {
        APP_BUNDLE_ID => app_profile,
        WIDGET_BUNDLE_ID => widget_profile
      }
    else
      export_options[:signingStyle] = "automatic"
      xcargs_list << "-allowProvisioningUpdates"
      export_xcargs_list << "-allowProvisioningUpdates"

      if key_id && !key_id.empty? && issuer_id && !issuer_id.empty? && key_path && !key_path.empty?
        expanded_key_path = File.expand_path(key_path)
        auth_flags = "-authenticationKeyPath '#{expanded_key_path}' -authenticationKeyID '#{key_id}' -authenticationKeyIssuerID '#{issuer_id}'"
        xcargs_list << auth_flags
        export_xcargs_list << auth_flags
      end
    end

    build_app(
      project: "NamazVakti.xcodeproj",
      scheme: "NamazVakti",
      configuration: "Release",
      clean: true,
      output_directory: "./build",
      output_name: "NamazVakti.ipa",
      export_method: "app-store-connect",
      export_options: export_options,
      xcargs: xcargs_list.join(" "),
      export_xcargs: export_xcargs_list.empty? ? nil : export_xcargs_list.join(" ")
    )
  end

  desc "Archive and upload a new build to TestFlight"
  lane :beta do |options|
    api_key = load_asc_api_key
    build(options)
    upload_to_testflight(
      api_key: api_key,
      ipa: "./build/NamazVakti.ipa",
      skip_waiting_for_build_processing: true
    )
  end

  desc "Alias for beta lane (TestFlight upload)"
  lane :testflight do |options|
    beta(options)
  end

  desc "Archive and upload a new build to App Store Connect"
  lane :release do |options|
    beta(options)
  end
end
