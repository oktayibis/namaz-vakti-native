# ==============================================================================
# Namaz Vakti — Local iOS TestFlight Credentials Template (ios/.env)
# ==============================================================================
# Copy this file to ios/.env (which is gitignored) and fill in your values:
#   cp ios/.env.example ios/.env
#
# Then run from the repository root:
#   ./scripts/ios-testflight.sh
# ==============================================================================

# 10-character Apple Developer Team ID (already matches ios/project.yml)
APPLE_TEAM_ID=3SN795A9D6

# App Store Connect API Key ID (Users and Access -> Integrations -> App Store Connect API)
APP_STORE_CONNECT_API_KEY_ID=2X9R4HXF34

# App Store Connect Issuer UUID
APP_STORE_CONNECT_ISSUER_ID=00000000-0000-0000-0000-000000000000

# Path to your downloaded AuthKey_<KEY_ID>.p8 file (or use APP_STORE_CONNECT_API_KEY_BASE64)
APP_STORE_CONNECT_API_KEY_PATH=~/.appstoreconnect/private_keys/AuthKey_2X9R4HXF34.p8
